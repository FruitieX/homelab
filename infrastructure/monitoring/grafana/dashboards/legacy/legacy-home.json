     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_add(time_bucket('1 day', time, 'Europe/Helsinki'), interval '1 day', 'Europe/Helsinki') AS time,\n  name, topic, sum(rate) AS rate\nFROM mqtt_consumer\nWHERE time >= date_subtract(date_trunc('day', now(), 'Europe/Helsinki'), interval '1 day', 'Europe/Helsinki') AND time < date_add(date_trunc('day', now(), 'Europe/Helsinki'), interval '1 day', 'Europe/Helsinki') AND time > now() - interval '2 days'\n  AND integration_id IS NULL AND device_id IS NULL AND name = 'watermeter'\n  AND rate > -20 AND rate < 20\n  AND extract(hour FROM time AT TIME ZONE 'Europe/Helsinki') * 60 + extract(minute FROM time AT TIME ZONE 'Europe/Helsinki')\n   <= extract(hour FROM now() AT TIME ZONE 'Europe/Helsinki') * 60 + extract(minute FROM now() AT TIME ZONE 'Europe/Helsinki')\nGROUP BY 1, 2, 3 ORDER BY 1",
     "refId": "A"
    }
   ],
   "title": "Total water consumption today vs. yesterday",
   "type": "stat"
