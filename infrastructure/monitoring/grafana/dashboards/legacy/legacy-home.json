    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"date\"\nimport \"timezone\"\n\noption location = timezone.location(name: \"Europe/Helsinki\")\n\nfrom(bucket: \"home\")\n  |> range(start: date.sub(from: today(), d: 1d), stop: date.add(to: today(), d: 1d))\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"_field\"] == \"rate\")\n  |> filter(fn: (r) => r[\"name\"] == \"watermeter\")\n  |> filter(fn: (r) => r[\"_value\"] < 20 and r[\"_value\"] > -20)\n  |> filter(fn: (r) => date.hour(t: r[\"_time\"]) * 60 + date.minute(t: r[\"_time\"]) <= date.hour(t: now()) * 60 + date.minute(t: now()))\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: false)\n  |> yield(name: \"sum\")\n",
     "refId": "A"
    }
   ],
   "title": "Total water consumption today vs. yesterday",
