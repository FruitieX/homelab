     "rawSql": "SELECT least(time_bucket($__interval_ms * interval '1 ms', time) + $__interval_ms * interval '1 ms', $__timeTo()) AS time,\n  avg(hum) * exp(0.0624 * (avg(tempc) - 22.0)) AS \"Value\"\nFROM mqtt_consumer\nWHERE $__timeFilter(time) AND device_id = 'D83534387029' AND brand = 'SwitchBot'\n  AND (tempc IS NOT NULL OR hum IS NOT NULL)\nGROUP BY 1 ORDER BY 1",
