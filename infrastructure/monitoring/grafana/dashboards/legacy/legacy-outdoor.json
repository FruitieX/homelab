   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"math\"\n\nfrom(bucket: \"home\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"_field\"] == \"tempc\" or r[\"_field\"] == \"hum\")\n  |> filter(fn: (r) => r[\"brand\"] == \"SwitchBot\")\n  |> filter(fn: (r) => r[\"device_id\"] == \"D83534387029\")\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ _time: r._time, _value: r.hum * math.e ^ (0.0624 * (r.tempc - 22.0)) }))",
     "refId": "A"
    }
   ],
   "title": "Outdoor air RH when heated to 22C",
   "type": "timeseries"
