      },
      "inspect": false
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    },
    "sortBy": [
     {
      "displayName": "Requests",
      "desc": true
     }
    ]
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "ua": "User agent",
       "Value #A": "Requests"
      },
      "excludeByName": {
       "Time": true
      }
     }
