  {
   "type": "stat",
   "title": "CPU temperature",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (node_hwmon_temp_celsius{job=\"proxmox-node\"} * on (instance, chip) group_left (chip_name) node_hwmon_chip_names{job=\"proxmox-node\", chip_name=~\"k10temp|coretemp\"})",
     "legendFormat": "{{host}}",
     "range": true,
     "instant": false,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "celsius",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3aa655",
        "value": null
