   "title": "Night-time water (02–05)",
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"timezone\"\nimport \"date\"\noption location = timezone.location(name: \"Europe/Helsinki\")\nfrom(bucket: \"home\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.name == \"watermeter\" and r._field == \"rate\")\n  |> filter(fn: (r) => r._value > -20.0 and r._value < 20.0)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> filter(fn: (r) => date.hour(t: r._time) >= 2 and date.hour(t: r._time) < 5)\n  |> aggregateWindow(every: 1d, fn: sum, createEmpty: true, timeSrc: \"_start\")",
     "refId": "A"
    }
   ],
   "fieldConfig": {
