  {
   "type": "stat",
   "title": "Spot price now",
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"timezone\"\noption location = timezone.location(name: \"Europe/Helsinki\")\nfrom(bucket: \"nordpool\")\n  |> range(start: -2h, stop: now())\n  |> filter(fn: (r) => r._measurement == \"price\" and r._field == \"price\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false, timeSrc: \"_start\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> last()",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "c/kWh",
     "decimals": 2,
