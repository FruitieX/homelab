  {
   "type": "timeseries",
   "title": "Outdoor air heated to 22 °C",
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"math\"\nfrom(bucket: \"home\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.device_id == \"D83534387029\")\n  |> filter(fn: (r) => r._field == \"tempc\" or r._field == \"hum\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.tempc and exists r.hum)\n  |> map(fn: (r) => ({_time: r._time, _value: r.hum * math.exp(x: 0.0624 * (r.tempc - 22.0))}))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "gradientMode": "opacity",
      "lineInterpolation": "smooth",
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisBorderShow": false,
      "barAlignment": -1,
      "thresholdsStyle": {
       "mode": "line+area"
      },
      "insertNulls": 3600000
     },
     "unit": "humidity",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#e5484d",
        "value": null
       },
       {
        "color": "#e0a100",
        "value": 25
       },
       {
        "color": "#3aa655",
        "value": 35
       }
      ]
     },
     "displayName": "RH at 22 °C"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
