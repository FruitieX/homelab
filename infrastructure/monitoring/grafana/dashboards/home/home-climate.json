     "rawSql": "SELECT * FROM (\n  SELECT $__timeGroupAlias(time, $__interval), avg(hum) * exp(0.0624 * (avg(tempc) - 22)) AS \"Value\"\n  FROM mqtt_consumer\n  WHERE $__timeFilter(time) AND device_id = 'D83534387029' AND (tempc IS NOT NULL OR hum IS NOT NULL)\n  GROUP BY 1) o\nWHERE \"Value\" IS NOT NULL ORDER BY 1",
