  {
   "type": "stat",
   "title": "Plug cost today",
   "targets": [
    {
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-home"
     },
     "query": "import \"timezone\"\noption location = timezone.location(name: \"Europe/Helsinki\")\nenergy = from(bucket: \"home\")\n  |> range(start: today(), stop: now())\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.integration_id == \"tuya\" and r._field == \"raw_19\")\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value) / 10.0, device: r.name}))\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false, timeSrc: \"_start\")\nprice = from(bucket: \"nordpool\")\n  |> range(start: today(), stop: now())\n  |> filter(fn: (r) => r._measurement == \"price\" and r._field == \"price\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false, timeSrc: \"_start\")\n  |> keep(columns: [\"_time\", \"_value\"])\njoin(tables: {e: energy, p: price}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, device: r.device, _value: r._value_e / 1000.0 * r._value_p / 100.0}))\n  |> group(columns: [\"device\"])\n  |> group() |> sum()",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "currencyEUR",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
