{
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "retention": {
      "dryRun": true,
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "private/**"
          ],
          "deleteUntagged": true,
          "deleteReferrers": true,
          "keepTags": [
            {
              "patterns": [
                "^retain-[0-9a-f]{64}$"
              ]
            },
            {
              "patterns": [
                "^(feature|dev|test|scratch)-.*"
              ],
              "pulledWithin": "720h",
              "pushedWithin": "720h",
              "mostRecentlyPushedCount": 4
            },
            {
              "patterns": [
                ".*"
              ]
            }
          ],
          "keepUntagged": {
            "pulledWithin": "720h",
            "pushedWithin": "720h",
            "mostRecentlyPushedCount": 4
          }
        },
        {
          "repositories": [
            "dockerhub/**",
            "ghcr/**",
            "quay/**",
            "k8s/**",
            "factory/**"
          ],
          "deleteUntagged": true,
          "deleteReferrers": true,
          "keepTags": [
            {
              "patterns": [
                "^retain-[0-9a-f]{64}$"
              ]
            },
            {
              "patterns": [
                ".*"
              ],
              "pulledWithin": "2160h",
              "pushedWithin": "2160h",
              "mostRecentlyPushedCount": 4
            }
          ],
          "keepUntagged": {
            "pulledWithin": "2160h",
            "pushedWithin": "2160h",
            "mostRecentlyPushedCount": 4
          }
        },
        {
          "repositories": [
            "**"
          ],
          "deleteUntagged": false,
          "deleteReferrers": false,
          "keepTags": [
            {
              "patterns": [
                ".*"
              ]
            }
          ]
        }
      ]
    },
    "gcDelay": "24h",
    "gcInterval": "1h",
    "gcTimeWindow": "03:00-04:00"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": [
      "docker2s2"
    ],
    "tls": {
      "cert": "/etc/zot/secrets/server.crt",
      "key": "/etc/zot/secrets/server.key"
    },
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/secrets/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": [
                "node-reader",
                "builder"
              ],
              "actions": [
                "read"
              ]
            },
            {
              "users": [
                "retention"
              ],
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            }
          ]
        },
        "private/**": {
          "policies": [
            {
              "users": [
                "builder"
              ],
              "actions": [
                "read",
                "create",
                "update"
              ]
            },
            {
              "users": [
                "node-reader"
              ],
              "actions": [
                "read"
              ]
            },
            {
              "users": [
                "retention"
              ],
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            }
          ]
        }
      }
    },
    "writeTimeout": "30m"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "credentialsFile": "/etc/zot/secrets/upstreams.json",
      "registries": [
        {
          "urls": [
            "https://index.docker.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "1s",
          "syncTimeout": "30m",
          "content": [
            {
              "prefix": "**",
              "destination": "/dockerhub"
            }
          ],
          "manifestCheckInterval": "5m"
        },
        {
          "urls": [
            "https://ghcr.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "1s",
          "syncTimeout": "30m",
          "content": [
            {
              "prefix": "**",
              "destination": "/ghcr"
            }
          ],
          "manifestCheckInterval": "5m"
        },
        {
          "urls": [
            "https://quay.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "1s",
          "syncTimeout": "30m",
          "content": [
            {
              "prefix": "**",
              "destination": "/quay"
            }
          ],
          "manifestCheckInterval": "5m"
        },
        {
          "urls": [
            "https://registry.k8s.io"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "1s",
          "syncTimeout": "30m",
          "content": [
            {
              "prefix": "**",
              "destination": "/k8s"
            }
          ],
          "manifestCheckInterval": "5m"
        },
        {
          "urls": [
            "https://factory.talos.dev"
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 2,
          "retryDelay": "1s",
          "syncTimeout": "30m",
          "content": [
            {
              "prefix": "**",
              "destination": "/factory"
            }
          ],
          "manifestCheckInterval": "5m"
        }
      ]
    }
  }
}
