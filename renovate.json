{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "description": "Pin container images to digests",
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Ignore self-hosted GHCR images (managed by cross-repo dispatch)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/fruitiex/**"
      ],
      "enabled": false
    },
    {
      "description": "Let new releases settle for a few days before proposing them; digests stay quick. Registries without release timestamps are not held forever",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Automerge non-major updates once all status checks (validate workflow) pass; Renovate merges itself, so direct pushes to main stay unrestricted",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "A Python minor release (3.13 -> 3.15) is a new runtime for the scripts that use it; review it",
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Major updates stay as PRs for review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Flux upgrades the GitOps engine itself: one grouped PR, reviewed by hand",
      "matchPackageNames": [
        "ghcr.io/fluxcd/**",
        "docker.io/fluxcd/**",
        "fluxcd/**"
      ],
      "groupName": "flux",
      "automerge": false
    },
    {
      "description": "Auth, ingress and database control planes deserve a glance before rollout",
      "matchPackageNames": [
        "ghcr.io/pocket-id/**",
        "docker.io/envoyproxy/**",
        "envoyproxy/**",
        "ghcr.io/cloudnative-pg/cloudnative-pg"
      ],
      "automerge": false
    },
    {
      "description": "Talos: one PR per patch and per minor step (minors must go one at a time), covering the tuppr plan and regen-configs.sh. Patches automerge and tuppr rolls them out at night; minors wait for review",
      "matchPackageNames": [
        "ghcr.io/siderolabs/installer"
      ],
      "groupName": "talos",
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Kubernetes: same as Talos",
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet"
      ],
      "groupName": "kubernetes",
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Talos and Kubernetes minor upgrades wait for review",
      "matchPackageNames": [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/kubelet"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Helm chart majors (kube-prometheus-stack, Loki, Grafana, ...) often need values or CRD changes: review, don't automerge",
      "matchManagers": [
        "flux"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "On 0.x versions a minor bump may break things (MetalLB, actions-runner-controller): review, don't automerge",
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Talos and Kubernetes versions in the tuppr plans (\"# renovate:\" comments)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/system-upgrade/plans/.+\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "Talos version used by regen-configs.sh for new nodes",
      "customType": "regex",
      "managerFilePatterns": [
        "/^regen-configs\\.sh$/"
      ],
      "matchStrings": [
        "TALOS_VERSION=(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/installer"
    },
    {
      "description": "Kubernetes version used by regen-configs.sh (written without the v)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^regen-configs\\.sh$/"
      ],
      "matchStrings": [
        "KUBERNETES_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/kubelet",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  }
}
